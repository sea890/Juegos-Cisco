
  font-size: 7px;
  line-height: 1.8;
  text-align: center;
  color: var(--muted);
}

@media (pointer: coarse), (max-width: 760px) {
  .hint {
    display: none;
  }

  .pad {
    display: flex;
  }

  .tool {
    width: 36px;
    height: 36px;
  }

  .back {
    height: 36px;
    font-size: 9px;
  }
}

@media (orientation: portrait) and (pointer: coarse) {
  .rotate-hint {
    display: block;
  }
}

.error {
  margin: 0;
  max-width: 640px;
  font-size: 8px;
  line-height: 1.8;
  text-align: center;
  color: var(--ink);
  border: 2px solid var(--ink);
  padding: 10px 14px;
  user-select: text;
  -webkit-user-select: text;
}

.error[hidden] {
  display: none;
}
